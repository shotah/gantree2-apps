# shared/ is generated by gantree (theme export + brand icons) but committed
# so a clone builds. Do not ignore it.

# gantree-android — each pattern used to be repo-root; scoped so it does not hide iOS
gantree-android/**/.gradle/
gantree-android/**/.idea/
gantree-android/**/*.iml
gantree-android/**/build/
gantree-android/**/local.properties
gantree-android/**/captures/
gantree-android/**/*.apk
gantree-android/**/*.ap_
gantree-android/**/*.aab
gantree-android/app/release/
gantree-android/app/debug/

# gantree-ios
gantree-ios/**/.build/
gantree-ios/**/.swiftpm/
gantree-ios/app/Helm.local.xcconfig
gantree-ios/**/xcuserdata/
gantree-ios/**/DerivedData/
gantree-ios/**/*.xcuserstate
gantree-ios/app/build/

# both apps
.DS_Store
.env
badges/
coverage.svg
dist/
