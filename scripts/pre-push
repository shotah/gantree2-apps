#!/usr/bin/env sh
# Pre-push: Android lint+tests, iOS lint, iOS tests, root scripts. Parallel.
set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if ! command -v lefthook >/dev/null 2>&1; then
  echo "lefthook is not on PATH. Install it, then re-run." >&2
  echo "https://github.com/evilmartians/lefthook#installation" >&2
  exit 1
fi

exec lefthook run pre-push "$@"
